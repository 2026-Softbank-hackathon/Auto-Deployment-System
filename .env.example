# 로컬 개발용 환경변수 예시. 실제 값은 .env 에 두고 절대 커밋하지 말 것.
DATABASE_URL=postgres://camellia:camellia@localhost:5433/camellia
API_PORT=3000
API_BASE_URL=http://localhost:3000
STORAGE_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage
NODE_ENV=development
LOG_LEVEL=info

# Secret API/Worker가 공유하는 AES-256-GCM 키. `openssl rand -base64 32`로 생성.
# 운영 환경에서는 필수이며 재시작해도 같은 값을 유지해야 한다.
# SECRET_MASTER_KEY=base64-encoded-32-byte-key

# AWS Terraform backend. 사전에 존재하는 사용자 계정 S3 bucket/KMS key를 지정.
# TERRAFORM_STATE_BUCKET=
# TERRAFORM_STATE_REGION=ap-northeast-2
# TERRAFORM_STATE_KMS_KEY_ID=arn:aws:kms:ap-northeast-2:123456789012:key/...
# TERRAFORM_BINARY=terraform

# AI (선택, 없으면 fill-unresolved skip)
# ANTHROPIC_API_KEY=sk-ant-...

# 인증 (P1)
# API_KEY=dev-local-key
