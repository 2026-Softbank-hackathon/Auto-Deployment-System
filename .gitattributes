.githooks/** text eol=lf
# 컨테이너 · 리눅스 호스트에서 실행되는 스크립트는 Windows 체크아웃에서도 LF 유지
*.sh text eol=lf
*.envsh text eol=lf
*.tftpl text eol=lf
# Windows Agent 설치 스크립트는 리눅스에서 패키징해도 CRLF 유지 (cmd 의 goto 레이블이 LF 에서 깨짐)
apps/onprem-agent/install/windows/*.cmd text eol=crlf
apps/onprem-agent/install/windows/*.ps1 text eol=crlf
