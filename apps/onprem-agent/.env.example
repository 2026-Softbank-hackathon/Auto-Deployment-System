ONPREM_CONTROL_PLANE_URL=https://server.example
# 최초 등록 시 한 번만 사용한다. LaunchAgent plist나 설치 파일에 저장하지 않는다.
ONPREM_AGENT_REGISTRATION_TOKEN=replace-with-one-time-registration-token
# 기본값은 ~/Library/Application Support/Camellia/onprem-agent 이다.
# ONPREM_AGENT_STATE_DIR=/absolute/path/to/onprem-agent
ONPREM_AGENT_POLL_INTERVAL_MS=2000
ONPREM_AGENT_HEARTBEAT_INTERVAL_MS=15000
