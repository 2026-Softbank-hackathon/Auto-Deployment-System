ONPREM_AGENT_ID=agent-seoul-01
# 최초 등록 개발 테스트 전용 값이다. LaunchAgent plist나 설치 파일에 저장하지 않는다.
ONPREM_AGENT_REGISTRATION_TOKEN=replace-with-one-time-registration-token
ONPREM_AGENT_STATE_DIR=.camellia/onprem-agent
ONPREM_AGENT_POLL_INTERVAL_MS=2000
ONPREM_AGENT_HEARTBEAT_INTERVAL_MS=15000
ONPREM_AGENT_CANCELLATION_POLL_INTERVAL_MS=1000
