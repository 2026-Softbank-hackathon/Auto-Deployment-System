{
  "name": "sample-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "camellia 데모용 단일 서비스 샘플 앱 (Node + TypeScript + Hono)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
