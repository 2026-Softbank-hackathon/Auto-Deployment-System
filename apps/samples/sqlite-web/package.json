{
  "name": "sample-sqlite-web",
  "version": "1.0.0",
  "private": true,
  "description": "camellia DB 전환 데모용 샘플 앱 — SQLite 파일 하나를 쓰는 방명록 (Node + TypeScript + Hono)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "dev": "npm run build && node dist/server.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
