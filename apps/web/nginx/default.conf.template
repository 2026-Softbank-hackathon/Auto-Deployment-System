# nginx 이미지 entrypoint 가 envsubst 로 렌더링 → /etc/nginx/conf.d/default.conf
# 치환 대상(NGINX_ENVSUBST_FILTER): ${API_UPSTREAM} ${PLATFORM_API_KEY} ${CONSOLE_AUTH_REALM}

# Bearer 요청은 Basic Auth 를 건너뛰고 API 가 Bearer 를 직접 검증한다.
map $http_authorization $camellia_auth_realm {
    "~*^Bearer\s"  off;
    default        "${CONSOLE_AUTH_REALM}";
}

map $http_authorization $camellia_injected_api_key {
    "~*^Bearer\s"  "";
    default        "${PLATFORM_API_KEY}";
}

# Basic Auth 자격증명은 API 로 넘기지 않는다.
map $http_authorization $camellia_upstream_authorization {
    "~*^Basic\s"   "";
    default        $http_authorization;
}

# Cloudflare Tunnel 뒤에서는 원래 scheme(https)을 그대로 전달
map $http_x_forwarded_proto $camellia_forwarded_proto {
    ""             $scheme;
    default        $http_x_forwarded_proto;
}

# Docker 내장 DNS. api 컨테이너가 재생성돼 IP 가 바뀌어도 다시 해석한다.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream camellia_api {
    zone camellia_api 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    client_max_body_size 110m;

    auth_basic $camellia_auth_realm;
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # 프록시 자체 헬스체크 (컨테이너 HEALTHCHECK)
    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API 헬스체크 — 인증 없이 공개 (API 도 인증 제외 경로)
    location = /health {
        auth_basic off;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    # On-Prem Agent 최초 등록 — 본문의 1회용 등록 토큰이 곧 크레덴셜 (Authorization 없음)
    location = /api/v1/agents/register {
        auth_basic off;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
    }

    # Swagger UI · OpenAPI JSON
    location /docs {
        include /etc/nginx/snippets/api-proxy.conf;
    }

    # Vite 해시 파일명 → 장기 캐시
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
