# infra/platform/.env 예시 — compose.yaml 이 읽는 값 전체 목록.
# 운영(EC2)에서는 scripts/deploy.sh 가 SSM Parameter Store(/camellia/platform/env/*)에서
# 이 파일을 자동으로 만든다. 로컬 검증 때만 직접 복사해서 채운다:
#   cp platform.env.example .env
# 실제 값은 절대 커밋하지 않는다 (.env 는 .gitignore 대상).
#
# 값에 따옴표 · 공백 · $ 를 쓰지 않는다. 키는 아래 명령으로 만든다.

# ── 필수 (비밀) ───────────────────────────────────────────────
# Postgres 비밀번호. DATABASE_URL 에 그대로 들어가므로 URL-safe 하게: openssl rand -hex 24
POSTGRES_PASSWORD=
# API 인증 키 (production 필수, PR #64). nginx 가 콘솔 요청에 X-API-Key 로 주입한다: openssl rand -hex 32
API_KEY=
# 시크릿 저장소 AES-256-GCM 키 (base64 32바이트). 바꾸면 기존 시크릿 복호화 불가: openssl rand -base64 32
SECRET_MASTER_KEY=
# 콘솔 Basic Auth 비밀번호 (사용자 이름은 CONSOLE_BASIC_AUTH_USER, 기본 camellia)
CONSOLE_BASIC_AUTH_PASSWORD=

# ── 운영 필수 (Cloudflare Tunnel) ─────────────────────────────
# Terraform 이 만들고 SSM 에 넣는다. 로컬에서는 비워 둔다 (tunnel 프로필을 켜지 않음)
CLOUDFLARE_TUNNEL_TOKEN=

# ── 선택 ─────────────────────────────────────────────────────
# CONSOLE_BASIC_AUTH_USER=camellia
# CONSOLE_BASIC_AUTH=off              # Basic Auth 끄기 (로컬 전용, 운영 금지)
# LOG_LEVEL=info
# VITE_DEMO_TARGET=aws                # 웹 빌드 기본 배포 대상 (aws | onprem)
# SESSION_TTL_SEC=3600

# 사용자 앱 고정 URL 발급 (service-{projectId}.<도메인>)
# DEMO_PLATFORM_DOMAIN=camellia-deploy.app

# 사용자 앱 Cloudflare DNS · Named Tunnel 관리용 (플랫폼 Tunnel 과 별개)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=

# AI 분석 보완 · 실패 진단 (D-56). 둘 다 없으면 규칙 분석만 한다
# AI_PROVIDER=anthropic               # anthropic(현재) | bedrock(계정 접근 · 전용 자격 증명 필요, 런북 4.8)
# ANTHROPIC_API_KEY=
# AI_MODEL_ANALYZE=                   # 모델 ID 덮어쓰기 (기본 claude-opus-5-5)
# AI_MODEL_DIAGNOSE=                  # 모델 ID 덮어쓰기 (기본 claude-sonnet-5-5)
# AI_MODEL_PATCH=                     # SQLite → PostgreSQL 코드 수정안 모델 (기본 AI_MODEL_ANALYZE 와 같음)

# 사용자 계정 Terraform state backend (S3 bucket · region · KMS key, 셋 다 있거나 셋 다 없거나)
# TERRAFORM_STATE_BUCKET=
# TERRAFORM_STATE_REGION=ap-northeast-2
# TERRAFORM_STATE_KMS_KEY_ID=

# ── 자동 ─────────────────────────────────────────────────────
# 호스트 docker 그룹 GID (worker 의 docker.sock 접근). deploy.sh 가 채운다
# DOCKER_GID=
