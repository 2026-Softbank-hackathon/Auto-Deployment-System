{
  "name": "camellia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "pnpm --filter @camellia/db migrate",
    "dev": "concurrently 'pnpm --filter @camellia/api dev' 'pnpm --filter @camellia/worker dev'",
    "dev:api": "pnpm --filter @camellia/api dev",
    "dev:worker": "pnpm --filter @camellia/worker dev",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.15.0",
    "form-data": "^4.0.0",
    "pg": "^8.0.0",
    "pg-boss": "^10.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
